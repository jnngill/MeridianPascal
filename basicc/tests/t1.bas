10 REM BASICS
20 FOR I=1 TO 5:PRINT I*I;:NEXT:PRINT
30 A=3:B=A/2:PRINT A;B;-B;1E10;.001;123.456
40 S$="HEL"+"LO":PRINT S$;LEN(S$);LEFT$(S$,2);RIGHT$(S$,3);MID$(S$,2,2)
50 GOSUB 100:PRINT "BACK"
60 IF A>2 THEN PRINT "BIG":ELSE PRINT "SMALL"
70 X=0:WHILE X<3:X=X+1:WEND:PRINT "X";X
80 REPEAT:X=X-1:UNTIL X=0:PRINT INT(-7/2);INT(7/2);ABS(-4);SGN(-3)
90 READ P,Q$:PRINT P;Q$:ON 2 GOTO 95,97
95 PRINT "WRONG"
97 PRINT "ON OK";NOT 0;3 AND 5;STR$(42):END
100 PRINT "SUB";:RETURN
200 DATA 7,"SEVEN"
