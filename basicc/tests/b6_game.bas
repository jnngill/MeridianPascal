10 REM A SMALL GAME LOOP WITHOUT PAUSE: MOVE, BOUNCE, CHECK WALLS
20 DIM X(7),Y(7),DX(7),DY(7)
30 FOR Z=0 TO 15:PATTERN 1,Z,"..7777777777777.":NEXT
40 FOR I=0 TO 7:X(I)=I*37:Y(I)=I*23:DX(I)=1+I:DY(I)=3-I:NEXT
50 FOR T=1 TO 300
60 FOR I=0 TO 7
70 X(I)=X(I)+DX(I):IF X(I)<0 OR X(I)>304 THEN DX(I)=-DX(I):X(I)=X(I)+DX(I)
80 Y(I)=Y(I)+DY(I):IF Y(I)<0 OR Y(I)>224 THEN DY(I)=-DY(I):Y(I)=Y(I)+DY(I)
90 SPRITE I,X(I),Y(I),1,I
100 NEXT I
110 IF KEY(32) THEN 130
120 NEXT T
130 FOR I=0 TO 7:SPRITE I:NEXT:PRINT "T";T;X(3);Y(3)
