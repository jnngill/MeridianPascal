  V('4.9E-38');
  V('1E38');
  V('7E-39');
  u.r := 1.0E30; WriteLn('L ', u.l);
  u.r := 0.1; WriteLn('L ', u.l);
  u.r := 3.14159; WriteLn('L ', u.l);
  u.r := 1E-30; WriteLn('L ', u.l);
  u.r := 6.02214076E23; WriteLn('L ', u.l);
  u.r := 16777217.0; WriteLn('L ', u.l);
  u.r := 2.7182818284590452353602874713527; WriteLn('L ', u.l);
  u.r := 3.4028234E38; WriteLn('L ', u.l);
  u.r := 1.17549435E-38; WriteLn('L ', u.l);
  u.r := 0.3; WriteLn('L ', u.l);
end.

