program ValReal;
{ Val and real literals must give the nearest real (ties to even), with the
  digits taken exactly (decimalToReal in compiler/types.js); -0 reads as 0 }
type TBits = record case integer of 0: (r: real); 1: (l: longint); end;
var u: TBits;
    code: integer;
procedure V(const s: string);
begin
  Val(s, u.r, code);
  WriteLn(s, ' ', u.l, ' ', code);
end;
begin
  V('1.0E30');
  V('1E30');
