program ValReal;
{ real literals compiled on the MERIDIAN must give the nearest real (ties to
  even), with the digits taken exactly, as the PC compiler does }
type TBits = record case integer of 0: (r: real); 1: (l: longint); end;
var u: TBits;
begin
  u.r := 1.0E30; WriteLn('1.0E30 ', u.l);
  u.r := 1E30; WriteLn('1E30 ', u.l);
  u.r := 3.14159; WriteLn('3.14159 ', u.l);
  u.r := 0.1; WriteLn('0.1 ', u.l);
  u.r := 0.3; WriteLn('0.3 ', u.l);
  u.r := 1E-30; WriteLn('1E-30 ', u.l);
  u.r := 2.5; WriteLn('2.5 ', u.l);
  u.r := 1E10; WriteLn('1E10 ', u.l);
  u.r := 0.000001234; WriteLn('0.000001234 ', u.l);
  u.r := 3.4E38; WriteLn('3.4E38 ', u.l);
  u.r := 3.4028234E38; WriteLn('3.4028234E38 ', u.l);
  u.r := 1.17549435E-38; WriteLn('1.17549435E-38 ', u.l);
  u.r := 16777217.000000001; WriteLn('16777217.000000001 ', u.l);
  u.r := 8388608.5; WriteLn('8388608.5 ', u.l);
  u.r := 8388609.5; WriteLn('8388609.5 ', u.l);
  u.r := 9.999999E37; WriteLn('9.999999E37 ', u.l);
  u.r := 6.02214076E23; WriteLn('6.02214076E23 ', u.l);
  u.r := 6.62607015E-34; WriteLn('6.62607015E-34 ', u.l);
  u.r := 0.5; WriteLn('0.5 ', u.l);
  u.r := 1E-10; WriteLn('1E-10 ', u.l);
  u.r := 000123.4500; WriteLn('000123.4500 ', u.l);
  u.r := 1.00000006; WriteLn('1.00000006 ', u.l);
  u.r := 1.0000001; WriteLn('1.0000001 ', u.l);
  u.r := 2.7182818284590452353602874713527; WriteLn('2.7182818284590452353602874713527 ', u.l);
  u.r := 0.1E1; WriteLn('0.1E1 ', u.l);
  u.r := 12345.678E-3; WriteLn('12345.678E-3 ', u.l);
  u.r := 4.9E-38; WriteLn('4.9E-38 ', u.l);
  u.r := 1E38; WriteLn('1E38 ', u.l);
  u.r := 7E-39; WriteLn('7E-39 ', u.l);
end.

